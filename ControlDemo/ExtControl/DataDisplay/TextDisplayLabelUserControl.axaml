<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="AvaloniaDemo.ExtControl.DataDisplay.TextDisplayLabelUserControl">
    <Grid ColumnDefinitions="Auto,*" RowDefinitions="30,30,30,30" Margin="8" RowSpacing="10">
        <SelectableTextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,8,4"
                             Text="官方文档：https://docs.avaloniaui.net/controls/data-display/text-display/label"/>

        <Label Grid.Row="1" Grid.Column="0" Target="firstNameBox" Content="First Name" Margin="0,0,8,4" />
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="firstNameBox" />

        <Label Grid.Row="2" Grid.Column="0" Target="lastNameBox" Content="Last Name" Margin="0,0,8,4" />
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="lastNameBox" />

        <Label Grid.Row="3" Grid.Column="0" Target="ageBox" Content="Age" Margin="0,0,8,4" />
        <NumericUpDown Grid.Row="3" Grid.Column="1" x:Name="ageBox" Minimum="10" Maximum="120" Increment="1" />
    </Grid>
</UserControl>
